{
  "name": "memodolmaeng",
  "private": true,
  "type": "module",
  "scripts": {
    "build:editor": "esbuild web-editor/src/editor.js --bundle --format=iife --global-name=MemoMarkdownEditor --define:__VUE_OPTIONS_API__=false --define:__VUE_PROD_DEVTOOLS__=false --define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --asset-names=fonts/[name]-[hash] --outfile=Sources/MemoDolmaeng/Resources/MarkdownEditor/editor.bundle.js",
    "test:editor": "node --test web-editor/test/*.test.js"
  },
  "dependencies": {
    "@milkdown/crepe": "7.21.2",
    "@milkdown/kit": "7.21.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  }
}
